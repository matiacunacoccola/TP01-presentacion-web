
<h1>Mi Grupo</h1>

<img src="@Url.Content("~/img/logo.jpg")" width="150" />
@foreach (var item in (Dictionary<int, Integrante>)ViewBag.Lista)
{
    <div class="integrante">
       <img src="@Url.Content("~/img/" + item.Value.Foto)" width="150" />
        <p>@item.Value.Nombre</p>

        <a href='@Url.Action("SelectIntegrante","Home", new { dni = item.Key })'>
            Ver más
        </a>
    </div>
}